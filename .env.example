# Environment variables. Copy this file to `.env` and fill in the values (`.env` and `.env.local`
# are git-ignored). On Vercel, set the same names for each environment.
#
# Optional local mode: `pnpm db:start` runs Supabase in Docker and `pnpm env:local` writes
# `.env.local`, which overrides `.env`. Delete `.env.local` to go back to the hosted project.

# --- Supabase (hosted project) ---------------------------------------------------------------------
# Dashboard → your project → Connect (or Project Settings → API Keys).
# Project URL, e.g. https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). The legacy anon key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Database (server only; never expose) ---------------------------------------------------------
# Dashboard → Connect → "Transaction pooler" (port 6543) with your database password filled in, e.g.
# postgresql://postgres.abcdefghijklmnopqrst:YOUR-PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# Use the pooler, not db.<ref>.supabase.co: the direct host is IPv6-only on some plans.
DATABASE_URL=
# Secret key (sb_secret_...): Project Settings → API Keys. Server only; used for file storage
# (signed uploads and downloads of résumés and job images). Never expose it to the browser.
SUPABASE_SECRET_KEY=

# --- Personal data encryption ------------------------------------------------------------------------
# 32 random bytes, base64. Encrypts candidates' email addresses and phone numbers. Every environment
# that shares a database needs the same value; back it up, because without it that data is lost.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=

# --- AI (Claude) -------------------------------------------------------------------------------------
# Reads application documents and screens them. Without a key, applications wait as "AI not set up".
ANTHROPIC_API_KEY=
# Development only: 1 replaces Claude with deterministic fake results (no API calls, no cost).
AI_FAKE=

# --- Supabase CLI: `pnpm db:link` and `pnpm db:push` -----------------------------------------------
# Project ref: the subdomain of the project URL (abcdefghijklmnopqrst).
SUPABASE_PROJECT_REF=
# The database password from DATABASE_URL, so the CLI doesn't prompt for it.
SUPABASE_DB_PASSWORD=

# --- App --------------------------------------------------------------------------------------------
# Base URL for links in auth emails. On Vercel it falls back to https://$VERCEL_URL when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shows "Sign in with Google" once the Google provider is enabled in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# --- Background jobs (Inngest) ---------------------------------------------------------------------
# Local: INNGEST_DEV=1 and run `pnpm inngest:dev`. Production: the keys from the Inngest dashboard.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Email (Resend) ---------------------------------------------------------------------------------
# Leave empty to log emails instead of sending them (dry run).
RESEND_API_KEY=
EMAIL_FROM=
# Signing secret of the Resend webhook (whsec_...) that reports delivered and bounced emails to
# /api/webhooks/resend. Resend dashboard → Webhooks.
RESEND_WEBHOOK_SECRET=
# Inbound mail (job-board notifications, candidate replies): the domain whose MX points at the
# provider (Postmark Inbound or similar), and the password in the provider webhook URL
# (https://inbound:SECRET@{app}/api/webhooks/inbound-email). Leave empty to turn inbound mail off.
INBOUND_DOMAIN=
INBOUND_WEBHOOK_SECRET=
# Receives marketing-site inquiries.
CONTACT_NOTIFY_EMAIL=

# --- Calendars, meetings and Gmail (設定 → 連携) --------------------------------------------------
# OAuth apps for connecting a company's accounts. Each provider stays unavailable until its pair is
# set. Redirect URI to register with each: {NEXT_PUBLIC_APP_URL}/api/oauth/{google|zoom|microsoft}/callback
# Google: Calendar (calendar.events, calendar.freebusy) and Gmail (gmail.send) are sensitive scopes,
# so the consent screen needs Google's verification before customers outside your Workspace can connect.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Zoom (General app, user-managed): scopes meeting:write:meeting, meeting:delete:meeting, user:read:user.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Microsoft Entra app (Teams via Outlook calendar events): delegated Calendars.ReadWrite, User.Read,
# offline_access. MICROSOFT_TENANT defaults to "common" (any work account).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=
# Meeting bot (Recall.ai) for transcripts and live assist in online interviews. RECALL_REGION defaults
# to ap-northeast-1. Japanese live transcription goes through Deepgram by default (add its key in
# Recall's dashboard); RECALL_TRANSCRIPT_PROVIDER overrides the provider as JSON.
RECALL_API_KEY=
RECALL_REGION=
RECALL_TRANSCRIPT_PROVIDER=
# Development only: "1" stands in for all of the above (instant connections, made-up meeting links,
# Gmail dry runs, and a bot that replays a sample interview). `pnpm env:local` sets it.
INTEGRATIONS_FAKE=

# --- Bot protection (Cloudflare Turnstile) -----------------------------------------------------------
# On the entry page, the contact form and /demo. Leave both empty to rely on the honeypot, timing
# check and rate limits only. Cloudflare publishes always-pass test keys for development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Error tracking (Sentry) -------------------------------------------------------------------------
# Leave empty to disable. SENTRY_AUTH_TOKEN is only needed in CI/Vercel to upload source maps.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Sign in with Google, local stack only (hosted: Dashboard → Authentication → Providers) ---------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
